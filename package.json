{
    "name": "selene",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/levigarciia/Selene.git"
    },
    "private": true,
    "description": "Ambiente desktop para inteligência artificial local",
    "author": "Selene",
    "license": "SEE LICENSE IN LICENSE.md",
    "type": "module",
    "main": "dist-electron/principal.cjs",
    "scripts": {
        "postinstall": "bun x install-electron",
        "dev": "bun scripts/desenvolver.ts",
        "dev:web": "vite --host 127.0.0.1",
        "verificar": "tsc --noEmit",
        "build:desktop": "bun scripts/compilar.ts",
        "build": "bun run verificar && vite build && bun run build:desktop",
        "start": "bun scripts/abrir.ts",
        "test:desktop": "bun scripts/testarDesktop.ts",
        "test:acesso-web": "bun scripts/testarDesktop.ts scripts/validarAcessoWeb.ts",
        "test:sidebar": "bun scripts/testarDesktop.ts scripts/validarSidebar.ts",
        "test:estatisticas": "bun scripts/testarDesktop.ts scripts/validarEstatisticas.ts",
        "test:openrouter": "bun scripts/testarDesktop.ts scripts/validarOpenRouter.ts",
        "test:icones": "bun scripts/testarDesktop.ts scripts/validarIconesAcoes.ts",
        "test:atividade": "bun scripts/testarDesktop.ts scripts/validarResumoTrabalho.ts",
        "test:projetos": "bun scripts/testarDesktop.ts scripts/validarProjetosRascunhos.ts",
        "test:gerenciamento": "bun scripts/testarDesktop.ts scripts/validarGerenciamentoProjeto.ts",
        "test:projetos-chat": "bun scripts/testarDesktop.ts scripts/validarProjetosChat.ts",
        "test:contexto": "bun scripts/testarDesktop.ts scripts/validarContextoImagens.ts",
        "test:repositorio": "bun scripts/testarDesktop.ts scripts/validarRepositorio.ts",
        "test:prs": "bun scripts/testarDesktop.ts scripts/validarPullRequests.ts",
        "test:envios-code": "bun scripts/testarDesktop.ts scripts/validarEnviosCode.ts",
        "test:web": "bun build scripts/fixtures/navegador.ts --target=node --external=electron --format=cjs --outfile=artifacts/navegador.cjs && bun scripts/testarDesktop.ts scripts/validarWeb.ts",
        "test:navegador-inline": "bun build scripts/fixtures/navegador.ts --target=node --external=electron --format=cjs --outfile=artifacts/navegador.cjs && bun scripts/testarDesktop.ts scripts/validarNavegadorInline.ts",
        "test:computador": "bun scripts/validarControladorComputador.ts && bun build scripts/fixtures/editorComputador.ts --target=node --external=electron --format=cjs --outfile=artifacts/editorComputador.cjs && bun scripts/testarDesktop.ts scripts/validarEditorComputador.ts && bun build scripts/fixtures/computador.ts --target=node --external=electron --format=cjs --outfile=artifacts/computador.cjs && bun scripts/testarDesktop.ts scripts/validarComputador.ts",
        "formatar": "prettier --write .",
        "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never",
        "dist:portable": "bun run build && electron-builder --win portable --x64 --publish never"
    },
    "trustedDependencies": [
        "electron",
        "esbuild"
    ],
    "build": {
        "appId": "com.selene.assistant",
        "productName": "Selene",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "docs/licenses/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "public/selene.ico",
                "to": "selene.ico"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Selene-Setup-${version}-${arch}.${ext}",
            "icon": "public/selene.ico",
            "signExecutable": false
        },
        "portable": {
            "artifactName": "Selene.exe"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Selene"
        },
        "publish": {
            "provider": "github",
            "owner": "levigarciia",
            "repo": "Selene",
            "releaseType": "draft"
        },
        "npmRebuild": false
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.325",
        "@fontsource-variable/inter": "^5.3.0",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@openuidev/lang-core": "^1.1.1",
        "@openuidev/react-lang": "^1.1.1",
        "@phosphor-icons/react": "^2.1.10",
        "@pierre/diffs": "^1.6.4",
        "diff": "^9.0.0",
        "electron-updater": "^6.8.11",
        "lucide-react": "0.564.0",
        "node-pty": "^1.2.0-beta.18",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "selfsigned": "^4.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "^44.11.3",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "playwright": "^1.65.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    },
    "overrides": {
        "qs": "^6.17.1",
        "@hono/node-server": "^2.1.8",
        "body-parser": "^2.4.0",
        "ip-address": "^10.7.6",
        "undici": "^7.30.2",
        "fast-uri": "^3.1.9",
        "hono": "^4.13.18",
        "minimatch": "^11.0.8"
    }
}
