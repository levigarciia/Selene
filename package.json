{
    "name": "selene",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/levigarciia/Selene.git"
    },
    "private": true,
    "description": "Ambiente desktop para inteligência artificial local",
    "author": "Selene",
    "license": "SEE LICENSE IN LICENSE.md",
    "type": "module",
    "main": "dist-electron/principal.cjs",
    "scripts": {
        "postinstall": "bun x install-electron",
        "dev": "bun scripts/desenvolver.ts",
        "dev:web": "vite --host 127.0.0.1",
        "verificar": "tsc --noEmit",
        "build:desktop": "bun scripts/compilar.ts",
        "build": "bun run verificar && vite build && bun run build:desktop",
        "start": "bun scripts/abrir.ts",
        "test:desktop": "bun scripts/testarDesktop.ts",
        "test:sidebar": "bun scripts/testarDesktop.ts scripts/validarSidebar.ts",
        "test:projetos": "bun scripts/testarDesktop.ts scripts/validarProjetosRascunhos.ts",
        "test:gerenciamento": "bun scripts/testarDesktop.ts scripts/validarGerenciamentoProjeto.ts",
        "test:projetos-chat": "bun scripts/testarDesktop.ts scripts/validarProjetosChat.ts",
        "test:contexto": "bun scripts/testarDesktop.ts scripts/validarContextoImagens.ts",
        "formatar": "prettier --write .",
        "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never",
        "dist:portable": "bun run build && electron-builder --win portable --x64 --publish never"
    },
    "trustedDependencies": [
        "electron",
        "esbuild"
    ],
    "build": {
        "appId": "com.selene.assistant",
        "productName": "Selene",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "public/selene.ico",
                "to": "selene.ico"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Selene-Setup-${version}-${arch}.${ext}",
            "icon": "public/selene.ico",
            "signExecutable": false
        },
        "portable": {
            "artifactName": "Selene.exe"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Selene"
        },
        "publish": {
            "provider": "github",
            "owner": "levigarciia",
            "repo": "Selene",
            "releaseType": "draft"
        }
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "electron-updater": "^6.6.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^44.7.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "playwright": "^1.64.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4"
    }
}
